RewriteEngine on
RewriteBase /

# Serve files when they are found
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
RewriteRule ^ - [L]

# The old Angular routes are gone — send them to their hash equivalent.
RewriteRule ^services/business-intelligence/?$ /#business-intelligence [R=301,L,NE]
RewriteRule ^services/software-strategy/?$    /#software-strategy    [R=301,L,NE]
RewriteRule ^services/tactical-management/?$  /#tactical-management  [R=301,L,NE]
RewriteRule ^legal/contact/?$                 /#contact              [R=301,L,NE]
RewriteRule ^legal/notice/?$                  /#notice               [R=301,L,NE]
RewriteRule ^legal/terms/?$                   /#terms                [R=301,L,NE]

# Anything else that is not a real file belongs on the single page
RewriteRule ^ / [R=301,L]

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresByType text/css                "access plus 1 week"
	ExpiresByType application/javascript  "access plus 1 week"
	ExpiresByType image/webp              "access plus 1 month"
	ExpiresByType image/png               "access plus 1 month"
	ExpiresByType image/svg+xml           "access plus 1 month"
	ExpiresByType font/woff2              "access plus 1 year"
	ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
